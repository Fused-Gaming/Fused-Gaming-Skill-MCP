{
  "name": "@h4shed/skill-creator",
  "version": "1.0.24",
  "description": "Create custom skills and tools for the Fused Gaming MCP ecosystem",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "echo \"No tests yet\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark": "npx tsx --expose-gc benchmarks/performance.benchmark.ts",
    "benchmark:release": "npx tsx --expose-gc --max-old-space-size=4096 benchmarks/release-performance.benchmark.ts"
  },
  "dependencies": {
    "@h4shed/mcp-core": "^1.0.24"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "mcp",
    "skill",
    "builder",
    "scaffold",
    "tooling"
  ],
  "author": "Fused Gaming",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
