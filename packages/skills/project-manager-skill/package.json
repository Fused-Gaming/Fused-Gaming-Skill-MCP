{
  "name": "@h4shed/skill-project-manager-skill",
  "version": "1.0.24",
  "description": "Task and project management skill for tracking work items and team collaboration",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "echo \"No tests yet\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark": "node --expose-gc --loader ts-node/esm benchmarks/performance.benchmark.ts",
    "benchmark:release": "node --expose-gc --max-old-space-size=4096 --loader ts-node/esm benchmarks/release-performance.benchmark.ts"
  },
  "dependencies": {
    "@h4shed/mcp-core": "^1.0.24"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "mcp",
    "skill",
    "project-manager",
    "task",
    "tracking"
  ],
  "author": "Fused Gaming",
  "license": "Apache-2.0"
}
