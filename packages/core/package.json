{
  "name": "@h4shed/mcp-core",
  "version": "1.0.24",
  "description": "Core MCP server and skill registry for Fused Gaming",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./registry": "./dist/skill-registry.js",
    "./server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "jest",
    "benchmark": "node scripts/collect-quality-metrics.mjs && tsc --project tsconfig.json && node dist/packages/core/src/benchmark.js"
  },
  "dependencies": {
    "@h4shed/benchmark-utils": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
