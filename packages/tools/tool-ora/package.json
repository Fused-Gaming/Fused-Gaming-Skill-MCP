  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ora",
    "spinner",
    "progress",
    "cli",
    "agents",
    "task-queue",
    "syncpulse",
    "@h4shed",
    "fused-gaming"
  ],
