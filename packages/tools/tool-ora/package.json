{
  "name": "@h4shed/tool-ora",
  "version": "7.0.0",
  "description": "Agent-aware terminal spinners, progress indicators, and task-context rendering for @h4shed ecosystem",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "npm run build && node --test dist/index.test.js"
  },
  "peerDependencies": {
    "ora": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
